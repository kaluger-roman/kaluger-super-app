# Database
DATABASE_URL="postgresql://user:password@localhost:5432/tutor_app"

# JWT
JWT_SECRET="your-secret-key"
ADMIN_JWT_SECRET="your-admin-secret-key"
# Аутентификация учеников — отдельный секрет от JWT_SECRET и ADMIN_JWT_SECRET (см. specs/029-student-cabinet)
STUDENT_JWT_SECRET="your-student-secret-key"

# Resend API for Email Verification
RESEND_API_KEY="re_your_api_key_here"
EMAIL_FROM="onboarding@resend.dev"

# Base URL of the frontend — used to build reset links in password reset emails
# Dev: http://localhost:3000, Prod: https://tutor.kaluger.ru
FRONTEND_URL="http://localhost:3000"

# Web Push (VAPID)
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:admin@tutor.kaluger.ru"

# Admin Panel
ADMIN_EMAIL="admin@tutor.kaluger.ru"
ADMIN_PASSWORD="$2b$12$..."  # bcrypt hash — generate with: node -e "require('bcryptjs').hash('pass',12).then(console.log)"

# Backup
BACKUP_DIR="backups"

# WebRTC ICE / STUN / TURN (видеозвонки, см. specs/030-webrtc-video-calls)
# STUN — необязателен, есть публичный дефолт stun:stun.l.google.com:19302
STUN_URL="stun:stun.l.google.com:19302"
# TURN-relay — необязателен локально, нужен в проде для пользователей за строгим NAT.
# Если TURN_URL/TURN_SECRET не заданы — приложение работает в режиме STUN-only:
# прямой P2P работает в разрешающих сетях, fallback через relay недоступен.
# Бэкенд чеканит time-limited TURN-креды (HMAC от секрета) на каждый звонок —
# сам секрет в браузер не уходит (coturn use-auth-secret / static-auth-secret).
TURN_URL="turn:turn.tutor.kaluger.ru:3478"
TURN_SECRET="your-coturn-static-auth-secret"
TURN_CREDENTIAL_TTL="86400"
