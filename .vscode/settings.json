{
    "eslint.workingDirectories": [
        {
            "directory": "frontend",
            "changeProcessCWD": true
        }
    ],
    "eslint.nodePath": "./frontend/node_modules",
    "eslint.validate": [
        "javascript",
        "javascriptreact",
        "typescript",
        "typescriptreact"
    ],
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": true
    }
}