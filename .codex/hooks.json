{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/changelog-gate.mjs\" --hook",
            "timeout": 30,
            "statusMessage": "Checking PR changelog"
          }
        ]
      }
    ]
  }
}
