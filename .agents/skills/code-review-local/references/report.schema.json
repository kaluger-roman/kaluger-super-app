{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "code-review-local report.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "branch": {
      "type": "string"
    },
    "base_ref": {
      "type": "string"
    },
    "threshold": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "iteration": {
      "type": "integer",
      "minimum": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "diff_stats": {
      "type": "object",
      "properties": {
        "files_changed": {
          "type": "integer",
          "minimum": 0
        },
        "insertions": {
          "type": "integer",
          "minimum": 0
        },
        "deletions": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "files_changed",
        "insertions",
        "deletions"
      ],
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "properties": {
        "raw_findings": {
          "type": "integer",
          "minimum": 0
        },
        "after_dedup": {
          "type": "integer",
          "minimum": 0
        },
        "after_score_filter": {
          "type": "integer",
          "minimum": 0
        },
        "by_severity": {
          "type": "object"
        },
        "by_category": {
          "type": "object"
        },
        "agents_failed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scorers_failed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "raw_findings",
        "after_dedup",
        "after_score_filter",
        "by_severity",
        "by_category"
      ],
      "additionalProperties": true
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "agent": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "category": {
            "enum": [
              "bug",
              "claude-md",
              "convention",
              "logic",
              "security",
              "type",
              "hack"
            ]
          },
          "file": {
            "type": "string"
          },
          "line_start": {
            "type": "integer",
            "minimum": 1
          },
          "line_end": {
            "type": "integer",
            "minimum": 1
          },
          "snippet": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "fix_hint": {
            "type": "string"
          },
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "verification_note": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "reason": {
            "enum": [
              "below threshold",
              "timeout",
              "unverified"
            ]
          }
        },
        "required": [
          "id",
          "agent",
          "title",
          "category",
          "file",
          "line_start",
          "line_end",
          "snippet",
          "rationale",
          "fix_hint",
          "score",
          "verification_note",
          "severity"
        ],
        "additionalProperties": true
      }
    },
    "filtered_out": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "agent": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "category": {
            "enum": [
              "bug",
              "claude-md",
              "convention",
              "logic",
              "security",
              "type",
              "hack"
            ]
          },
          "file": {
            "type": "string"
          },
          "line_start": {
            "type": "integer",
            "minimum": 1
          },
          "line_end": {
            "type": "integer",
            "minimum": 1
          },
          "snippet": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "fix_hint": {
            "type": "string"
          },
          "score": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              {
                "type": "null"
              }
            ]
          },
          "verification_note": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "reason": {
            "enum": [
              "below threshold",
              "timeout",
              "unverified"
            ]
          }
        },
        "required": [
          "id",
          "agent",
          "title",
          "category",
          "file",
          "line_start",
          "line_end",
          "snippet",
          "rationale",
          "fix_hint",
          "score",
          "verification_note",
          "reason"
        ],
        "additionalProperties": true
      }
    },
    "coverage": {
      "type": "object",
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "reviewers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "completed",
                  "failed",
                  "unavailable",
                  "not-applicable"
                ]
              },
              "note": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "role",
              "status"
            ],
            "additionalProperties": true
          }
        },
        "scorers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "finding_id": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "completed",
                  "timeout",
                  "failed",
                  "unavailable"
                ]
              },
              "score": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "verification_note": {
                "type": "string"
              }
            },
            "required": [
              "finding_id",
              "status",
              "score",
              "verification_note"
            ],
            "additionalProperties": true
          }
        }
      },
      "required": [
        "complete",
        "reviewers",
        "scorers"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "schema_version",
    "branch",
    "base_ref",
    "threshold",
    "iteration",
    "timestamp",
    "diff_stats",
    "summary",
    "findings",
    "filtered_out",
    "coverage"
  ],
  "additionalProperties": true,
  "description": "Schema for newly produced reports. Legacy v1 reports remain unchanged: enrich missing steps from the linked Markdown in memory, and mark absent reviewer/scorer coverage as unknown rather than clean."
}
