{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "manual-qa round-context.schema.json",
  "type": "object",
  "properties": {
    "iteration": {
      "type": "integer",
      "minimum": 1
    },
    "must_check": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expected": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "steps",
          "expected"
        ],
        "additionalProperties": true
      }
    },
    "recheck": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "finding_title": {
            "type": "string"
          },
          "scenario_id": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expected": {
            "type": "string"
          }
        },
        "required": [
          "finding_title",
          "steps",
          "expected"
        ],
        "additionalProperties": true
      }
    },
    "covered_scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title"
        ],
        "additionalProperties": true
      }
    },
    "known_open_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "scenario_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "open",
              "rejected"
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "status"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [],
  "additionalProperties": true
}
