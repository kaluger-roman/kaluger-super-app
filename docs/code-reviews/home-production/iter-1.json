      "snippet": "set -o pipefail\ndc exec -T db pg_dump -U postgres -d tutor_app | gzip > \"$BACKUP_FILE.tmp\"\ngzip -t \"$BACKUP_FILE.tmp\" && mv \"$BACKUP_FILE.tmp\" \"$BACKUP_FILE\"",
