listening-ip=__LAN_IP__
relay-ip=__LAN_IP__
external-ip=__PUBLIC_IP__/__LAN_IP__
listening-port=3478
tls-listening-port=5349
min-port=49160
max-port=49175

realm=turn.tutor.kaluger.ru
fingerprint
use-auth-secret
static-auth-secret=__TURN_SECRET__
cert=/certs/current/fullchain.pem
pkey=/certs/current/privkey.pem
no-tlsv1
no-tlsv1_1
no-dtls

no-cli
no-loopback-peers
no-multicast-peers
no-tcp-relay
no-software-attribute
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=240.0.0.0-255.255.255.255
denied-peer-ip=::1-::1
denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff

user-quota=4
total-quota=16
max-bps=1048576
bps-capacity=8388608
pidfile=/tmp/turnserver.pid
userdb=/tmp/turndb
log-file=stdout
simple-log
