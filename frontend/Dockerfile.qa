# QA-only frontend image. Produces the production CRA build and serves it via nginx,
# proxying /api and /ws to the backend container (mirrors the real prod nginx setup).
FROM node:20-slim AS build

WORKDIR /app
# CI=true would turn CRA lint warnings into build-breaking errors.
ENV CI=false

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM nginx:alpine
COPY nginx.qa.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/build /usr/share/nginx/html
