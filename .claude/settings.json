{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-changelog-before-pr.sh",
            "if": "Bash(gh pr create*)",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
